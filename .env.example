# Median Environment Configuration
# Copy this to .env and customize

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080                              # External port (NGINX)

# ── Paths ─────────────────────────────────────────────────────────────────────
UPLOAD_FOLDER=/app/downloads
BACKUP_FOLDER=/app/backups
LOG_FOLDER=/app/logs
DATABASE_PATH=/app/database/median.db

# ── Cleanup ───────────────────────────────────────────────────────────────────
CLEANUP_INTERVAL=90                    # Minutes until downloaded files are deleted (also the sweep interval, so real retention is 90-180 min)
BATCH_HOLD_HOURS=3                     # Hours a finished discography batch waits to be collected before normal cleanup resumes
BATCH_DELETE_MINUTES=3                 # Minutes after the combined zip is downloaded before the album copies are deleted

# ── Auto-update ───────────────────────────────────────────────────────────────
AUTO_UPDATE_INTERVAL=48                # Hours between yt-dlp/FFmpeg updates

# ── Downloads ─────────────────────────────────────────────────────────────────
DOWNLOAD_CHUNK_SIZE=5                  # MB — HTTP chunk size for downloads

# ── Spotify ───────────────────────────────────────────────────────────────────
# No API key or account is needed. Spotify's audio is DRM-protected, so Median
# reads the tracklist from a Spotify link and fetches the recordings from
# YouTube. These tune that matching step.
# MAX_SPOTIFY_PLAYLIST_TRACKS=200      # Cap on tracks taken from one album/playlist
# SPOTIFY_MATCH_CONCURRENCY=4          # Parallel YouTube searches
# YT_MATCH_RESULTS=5                   # Search results scored per track
# YT_MATCH_VERIFY=3                    # Top candidates checked for availability

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_BACKUP_COUNT=7
# LOG_FORMAT=text                       # text or json

# ── Cover Settings ────────────────────────────────────────────────────────────
COVER_DEFAULT_RATIO=1:1
COVER_DEFAULT_RESOLUTION=original

# ── Blurry Background Padding ─────────────────────────────────────────────────
BLURRY_PADDING_ENABLED=true
BLURRY_PADDING_BLUR_RADIUS=40

# ── Concatenation ─────────────────────────────────────────────────────────────
CONCATENATION_VALIDATE_BEFORE=true
CONCATENATION_CREATE_CHAPTERS=true

# ── Database ──────────────────────────────────────────────────────────────────
# (SQLite WAL mode auto-enabled, no config needed)

# ── Security ──────────────────────────────────────────────────────────────────
# MEDIAN_API_TOKEN=                   # Uncomment to enable bearer token auth

# ── History Retention ────────────────────────────────────────────────────────
# HISTORY_RETENTION_DAYS=90            # 0 = keep forever

# ── Concurrent Downloads ─────────────────────────────────────────────────────
# MAX_CONCURRENT_DOWNLOADS=3
